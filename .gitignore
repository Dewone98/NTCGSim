# Build output
.build/
DerivedData/
*.xcuserstate
xcuserdata/

# ---------------------------------------------------------------------------
# Card artwork ships inside the app so every install looks identical, so the
# bundled set at NTCGSimulator/Resources/CardArt/ is TRACKED on purpose.
#
# Everything else image-shaped stays out: stray photo exports, scratch copies and
# anything dropped into the app's on-device container. The negation below is
# deliberately narrow — widen it and unrelated art starts getting committed.
*.avif
*.AVIF
*.heic
*.HEIC
*.heif
*.webp
!NTCGSimulator/Resources/CardArt/
!NTCGSimulator/Resources/CardArt/*.AVIF
!NTCGSimulator/Resources/CardArt/*.avif

NTCGSimulator/Resources/cards/
NTCGSimulator/Resources/**/*.jpg
NTCGSimulator/Resources/**/*.jpeg

# Research notes: durable on disk, deliberately untracked.
notes/
